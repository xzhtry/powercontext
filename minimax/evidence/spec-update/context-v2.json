      "snippet": "def _run_list(args: argparse.Namespace) -> int:\n    invoices = load_invoices(args.data)\n    min_amount = Decimal(args.min_amount) if args.min_amount is not None else None\n    page = list_invoices(\n        invoices,\n        status=args.status,\n        customer_id=args.customer,\n        min_amount=min_amount,\n        page=args.page,\n        page_size=args.page_size,\n    )\n    print(\n        json.dumps(\n            {\n                \"items\": [_invoice_to_dict(item) for item in page.items],\n                \"page\": page.page,\n                \"page_size\": page.page_size,\n                \"total\": page.total,\n                \"page_count\": page.page_count,\n                \"has_next\": page.has_next,\n            },\n            ensure_ascii=False,\n            indent=2,\n        )\n    )\n    return 0",
      "score": 3.0,
