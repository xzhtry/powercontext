# 复制为 .env 后填写。不要把真实 Key 提交到仓库。
MINIMAX_API_KEY=replace-me
# anthropic（Claude Code 兼容，Token/M Plan 订阅 Key）或 openai（按量计费 API Key）
MINIMAX_PROTOCOL=anthropic
MINIMAX_BASE_URL=https://api.minimax.cn/anthropic
MINIMAX_MODEL=MiniMax-M3.1-Flash
# 思考深度：low/medium/high/xhigh/max。低档位更快、更省 token，适合输出补丁。
MINIMAX_EFFORT=low

POWERCONTEXT_URL=http://127.0.0.1:8765

# 可选：把 seekdb / 状态目录放到 Linux 文件系统（WSL 的 /mnt/* 不支持嵌入式 seekdb）
# SDDCTX_RUNTIME=/home/yourname/.local/share/sddctx
