# ---- seekdb ----
# server: connect to a local seekdb server (recommended; also works with Docker)
# embedded: open a data directory in-process (Linux/macOS; requires native bindings)
SEEKDB_MODE=server
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=stepkb
# Embedded only:
SEEKDB_PATH=.data/seekdb

# ---- app ----
PORT=8787
HOST=127.0.0.1
