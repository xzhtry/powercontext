# Runtime data (seekdb store, PowerContext SQLite, session scope, logs)
# Default on Windows when the checkout path contains non-ASCII characters:
#   %USERPROFILE%\ResearchThread
# Default on a normal ASCII checkout: ./runtime
# RT_RUNTIME=C:\Users\you\ResearchThread

# Web app
RT_HOST=127.0.0.1
RT_PORT=8787

# seekdb server port (Windows server mode; choose outside Windows excluded ranges)
RT_SEEKDB_PORT=18881
# Optional explicit binary
# RT_SEEKDB_BIN=C:\path\to\seekdb.exe

# PowerContext
RT_PC_PORT=18765
# RT_PC_URL=http://127.0.0.1:18765
# RT_PC_BIN=C:\path\to\powercontext.exe

# Set to 0 to run the app without starting seekdb / PowerContext automatically
RT_AUTOSTART=1
# Set to 0 to skip the curated demo evidence on a fresh database
RT_SEED_DEMO=1
